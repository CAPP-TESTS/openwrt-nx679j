diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index cb68adcab..2e89ed8a4 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -84,6 +84,7 @@
 SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
 	bl	preserve_boot_args
+	bl	nx679j_gunyah_wdt_fingerprint
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -128,6 +129,46 @@ SYM_CODE_START(primary_entry)
 	bl	__cpu_setup			// initialise processor
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
+/*
+ * Diagnostic-only NX679J execution fingerprint. Rearm the Gunyah watchdog
+ * for three seconds before the MMU, page tables, DT parsing, or initcalls.
+ * A reset near that deadline proves the bootloader entered this Image and
+ * that the vendor-hypervisor watchdog ABI is callable this early.
+ */
+SYM_CODE_START_LOCAL(nx679j_gunyah_wdt_fingerprint)
+	movz	x0, #0x0005
+	movk	x0, #0x8600, lsl #16		// GUNYAH_WDT_CONTROL
+	mov	x1, #2				// disable
+	mov	x2, xzr
+	mov	x3, xzr
+	mov	x4, xzr
+	mov	x5, xzr
+	mov	x6, xzr
+	mov	x7, xzr
+	smc	#0
+
+	movz	x0, #0x0008
+	movk	x0, #0x8600, lsl #16		// GUNYAH_WDT_SET_TIME
+	mov	x1, #3000
+	mov	x2, x1
+	smc	#0
+
+	movz	x0, #0x0005
+	movk	x0, #0x8600, lsl #16		// GUNYAH_WDT_CONTROL
+	mov	x1, #3				// enable
+	mov	x2, xzr
+	smc	#0
+
+	movz	x0, #0x0007
+	movk	x0, #0x8600, lsl #16		// GUNYAH_WDT_PING
+	mov	x1, xzr
+	mov	x2, xzr
+	smc	#0
+
+.Lnx679j_wdt_wait:
+	wfe
+	b	.Lnx679j_wdt_wait
+SYM_CODE_END(nx679j_gunyah_wdt_fingerprint)
 
 	__INIT
 SYM_CODE_START_LOCAL(record_mmu_state)
