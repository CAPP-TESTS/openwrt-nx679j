# NX679J headless OpenWrt boot-critical drivers.
# Keep this fragment limited to features required before a module filesystem
# exists. The first test deliberately uses DWC3 gadget-only, USB 2.0 mode.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_NCM=y
CONFIG_USB_G_NCM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
# Diagnostic output through the framebuffer already initialized by ABL.
# This does not probe MDSS, DSI, or the panel.
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_8x16=y

# sm8450 usb_1_hsphy is qcom,usb-snps-hs-7nm-phy.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# dr_mode = "peripheral" makes PMIC GLINK/UCSI role switching non-critical
# for this USB 2.0 test; do not pull the DRM dependency into the headless image.

# UFS must probe from the kernel image so the headless test can verify storage.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Preserve failure evidence across a recovery boot.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# The external OpenWrt ramdisk configures usb0 directly.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
