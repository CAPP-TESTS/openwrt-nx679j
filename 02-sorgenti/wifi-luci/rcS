#!/bin/sh
# nx679j: rcS standard ricreato — l'immagine non lo aveva (inittab vuoto):
# i servizi /etc/rc.d/S* non venivano mai avviati al boot.
[ "$1" = "S" ] && {
	logger -s -t procd "Running boot..."
	for i in /etc/rc.d/S*; do
		[ -x "$i" ] || continue
		"$i" boot
	done
	logger -s -t procd "Boot done"
}
[ "$1" = "K" ] && {
	for i in $(ls -r /etc/rc.d/K* 2>/dev/null); do
		[ -x "$i" ] && "$i" stop
	done
}
exit 0
