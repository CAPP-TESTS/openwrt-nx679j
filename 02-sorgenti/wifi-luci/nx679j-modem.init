#!/bin/sh /etc/rc.common
# nx679j-modem — avvia la catena modem X65 al boot.
# Toolkit persistente in /usr/lib/nx679j/modem (prima stava in /tmp, tmpfs).
# Gli script della catena usano path /tmp/...: qui creiamo i symlink.
USE_PROCD=1
START=95

start_service() {
	mkdir -p /tmp /var/run/nx679j /rfs/readwrite/ota_firewall /var/lib/tqftpserv
	# symlink toolkit persistente -> /tmp (gli script usano /tmp/...)
	for f in /usr/lib/nx679j/modem/*; do
		b="${f##*/}"
		[ -e "/tmp/$b" ] || ln -s "$f" "/tmp/$b"
	done
	procd_open_instance
	procd_set_param command /usr/lib/nx679j/modem/chain.sh
	procd_set_param stdout 1
	procd_set_param stderr 1
	
	procd_close_instance
}
